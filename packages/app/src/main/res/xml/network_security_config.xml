<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The Home Assistant and Immich URLs are entered at runtime, and this file cannot name
         hosts that are unknown at build time. Cleartext and user CAs are therefore allowed for
         every host, to support local HTTP and self-signed setups. Settings warns about http:// URLs. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
